<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/cinema</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/cinema</item>
        <item name="android:navigationBarColor">@color/cinema</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:alertDialogTheme">@style/TemaDialogo</item>
    </style>
    <!-- Diálogos (nombre, mensaje, ayuda, widget…) con los colores de la app. -->
    <style name="TemaDialogo" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialogo</item>
        <item name="android:buttonBarButtonStyle">@style/BotonDialogo</item>
        <item name="android:colorBackground">@color/cinema</item>
        <item name="android:colorAccent">@color/gold_light</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">@color/cream_soft</item>
        <item name="android:textColorAlertDialogListItem">@color/cream</item>
        <item name="android:textColor">@color/cream</item>
    </style>
    <style name="BotonDialogo" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/gold_light</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="AccionTexto" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gold_light</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
    <style name="AccionSecundaria" parent="AccionTexto">
        <item name="android:background">@drawable/accion_inicio</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cream</item>
    </style>
    <style name="AccionPrincipal" parent="AccionSecundaria">
        <item name="android:background">@drawable/enviar_inicio</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- La libreta: una hoja sobre un escritorio de madera, sin los colores de cine. -->
    <style name="TemaLibreta" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/escritorio</item>
        <item name="android:statusBarColor">@color/escritorio</item>
        <item name="android:navigationBarColor">@color/escritorio</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/tapa_tela</item>
        <item name="android:textColor">@color/tinta_lapiz</item>
    </style>
    <!-- El tablero de corcho: una pared clara con el corcho colgado. -->
    <style name="TemaTablero" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/corcho_pared</item>
        <item name="android:statusBarColor">@color/corcho_pared</item>
        <item name="android:navigationBarColor">@color/corcho_pared</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/chincheta_roja</item>
        <item name="android:textColor">@color/corcho_tinta</item>
    </style>
    <!-- La notita que el widget de la libreta abre encima de la pantalla de inicio (firmar una propuesta). -->
    <style name="TemaNotaWidget" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColor">@color/tinta_lapiz</item>
    </style>
</resources>
