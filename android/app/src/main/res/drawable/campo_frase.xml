<?xml version="1.0" encoding="utf-8"?>
<!-- El campo de la frase del toque: un recuadro con borde dorado que abre la lista al tocarlo. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33F3D580">
    <item>
        <shape>
            <solid android:color="@color/gold_glow" />
            <stroke android:width="1dp" android:color="@color/taquilla_borde" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
