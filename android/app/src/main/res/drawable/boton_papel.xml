<?xml version="1.0" encoding="utf-8"?>
<!-- Botón ♥ Toque de Papel. Se marca al instante al presionar y se suelta con un fundido corto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true"><shape><solid android:color="@color/papel_rojo_presionado" /><corners android:radius="99dp" /></shape></item>
    <item><shape><solid android:color="@color/papel_rojo" /><corners android:radius="99dp" /></shape></item>
</selector>
