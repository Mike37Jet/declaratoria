<?xml version="1.0" encoding="utf-8"?>
<!-- El tablero de corcho antes de dibujarse (y en la vista previa): corcho claro con marco blanco. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/corcho_marco" /><corners android:radius="@dimen/radio_widget" /></shape></item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape>
            <solid android:color="@color/corcho" />
            <stroke android:width="1dp" android:color="@color/corcho_canto" />
            <corners android:radius="@dimen/radio_widget" />
        </shape>
    </item>
</layer-list>
