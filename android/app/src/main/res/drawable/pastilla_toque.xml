<?xml version="1.0" encoding="utf-8"?>
<!-- Las frases del toque: la elegida va rellena de dorado. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33F3D580">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/gold" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <stroke android:width="1dp" android:color="@color/taquilla_borde" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
