<?xml version="1.0" encoding="utf-8"?>
<!-- Botón ♥ Toque de Coral. Se marca al instante al presionar y se suelta con un fundido corto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true"><shape><solid android:color="@color/coral_crema" /><corners android:radius="18dp" /></shape></item>
    <item><shape><solid android:color="@color/blanco" /><corners android:radius="18dp" /></shape></item>
</selector>
