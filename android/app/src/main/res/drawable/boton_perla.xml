<?xml version="1.0" encoding="utf-8"?>
<!-- Botón ♥: se marca al instante al presionar y se suelta con un fundido corto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#24A85F6B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
