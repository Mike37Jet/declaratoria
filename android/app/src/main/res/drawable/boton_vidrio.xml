<?xml version="1.0" encoding="utf-8"?>
<!-- Pastillas de vidrio. Se marca al instante al presionar y se suelta con un fundido corto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true"><shape><solid android:color="@color/vidrio_presionado" /><stroke android:width="1dp" android:color="@color/vidrio_filo" /><corners android:radius="99dp" /></shape></item>
    <item><shape><solid android:color="@color/vidrio_pastilla" /><stroke android:width="1dp" android:color="@color/vidrio_borde" /><corners android:radius="99dp" /></shape></item>
</selector>
