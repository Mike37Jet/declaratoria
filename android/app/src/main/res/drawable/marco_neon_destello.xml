<?xml version="1.0" encoding="utf-8"?>
<!-- El neón cuando llega un toque: el tubo cambia a cian por un instante. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/neon_fondo" />
            <stroke android:width="5dp" android:color="@color/neon_cian_halo" />
            <corners android:radius="@dimen/radio_widget" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape>
            <stroke android:width="2dp" android:color="@color/neon_cian" />
            <corners android:radius="@dimen/radio_widget_neon_interno" />
        </shape>
    </item>
</layer-list>
