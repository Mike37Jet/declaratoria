<?xml version="1.0" encoding="utf-8"?>
<!-- Perla: marfil con doble filete en oro rosa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/perla_fondo" />
            <stroke android:width="1dp" android:color="@color/perla_borde" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape>
            <stroke android:width="1dp" android:color="@color/perla_borde" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
