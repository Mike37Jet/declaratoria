<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjetas que se encogen apenas al presionarlas y vuelven al soltarlas.
     Si el celular tiene las animaciones desactivadas, Android las omite solo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:interpolator="@interpolator/salida"
                android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:interpolator="@interpolator/salida"
                android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:interpolator="@interpolator/salida"
                android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:interpolator="@interpolator/salida"
                android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
