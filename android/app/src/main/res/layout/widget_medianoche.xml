<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Medianoche: solo los días en grande y el reloj debajo.
     Las horas van dentro del reloj ("05 h · 42:18"), así que no hay id "horas". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/marco_medianoche" android:gravity="center" android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:baselineAligned="true" android:orientation="horizontal">
        <TextView android:id="@+id/dias" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin" android:letterSpacing="-0.02" android:maxLines="1" android:text="37"
            android:textColor="@color/medianoche_texto" android:textSize="38sp" />
        <TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:fontFamily="sans-serif-light" android:text="días"
            android:textColor="@color/medianoche_gris" android:textSize="14sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="6dp"
        android:background="@drawable/linea_medianoche" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light" android:letterSpacing="0.1" android:textColor="@color/medianoche_gris"
            android:textSize="12sp" />
        <TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="2dp" android:background="@drawable/boton_medianoche"
            android:contentDescription="Mandar un toque" android:gravity="center" android:minWidth="40dp"
            android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:text="♡"
            android:textColor="@color/medianoche_texto" android:textSize="15sp" />
    </LinearLayout>
    <!-- Solo aparece cuando hay un toque reciente. -->
    <TextView android:id="@+id/pie" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:ellipsize="end" android:fontFamily="sans-serif-light" android:maxLines="1"
        android:textColor="@color/medianoche_gris" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
