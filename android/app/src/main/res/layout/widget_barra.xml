<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Barra Now (One UI): cápsula negra y barra hacia el próximo mes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_barra" android:orientation="vertical" android:padding="21dp" android:gravity="center_vertical"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/enviar_toque" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/boton_barra" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/blanco" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp"><TextView android:id="@+id/pie" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Juntos desde el sí" android:fontFamily="sans-serif" android:textColor="@color/barra_gris" android:textSize="13sp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="26sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="26sp" android:layout_marginStart="6dp"/></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="16sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=":" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="16sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="16sp" /></LinearLayout></LinearLayout>
<ProgressBar android:id="@+id/barra" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="630" android:progressDrawable="@drawable/barra_progreso" android:layout_marginTop="16dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="este mes" android:fontFamily="sans-serif" android:textColor="@color/barra_gris" android:textSize="10sp" android:layout_weight="1"/>
<TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/barra_gris" android:textSize="10sp" /></LinearLayout></LinearLayout>
