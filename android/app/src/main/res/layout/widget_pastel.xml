<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Pastel (One UI): lila claro y número grueso. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_pastel" android:orientation="vertical" android:padding="21dp" ><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/pie" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="♥ Rommina y Miguel" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_morado" android:textSize="13sp" android:layout_weight="1"/>
<TextView android:id="@+id/enviar_toque" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/boton_pastel" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/blanco" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" /></LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_tinta" android:textSize="55sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_tinta" android:textSize="16sp" android:layout_marginStart="8dp"/></LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/chip_pastel" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:layout_marginEnd="6dp" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_tinta" android:textSize="13sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" h" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_tinta" android:textSize="13sp" /></LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/chip_pastel" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:layout_marginEnd="6dp" android:gravity="center_vertical"><Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-black" android:textColor="@color/pastel_tinta" android:textSize="13sp" /></LinearLayout>
<TextView android:id="@+id/meta" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/pastel_morado" android:textSize="10sp" android:layout_weight="1"/></LinearLayout></LinearLayout>
