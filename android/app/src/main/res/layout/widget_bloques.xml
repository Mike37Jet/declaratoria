<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Bloques (One UI): fichas de color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_bloques" android:orientation="vertical" android:padding="13dp" ><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/pie" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Juntos ♥" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="13sp" android:layout_weight="1" android:paddingStart="4dp"/>
<TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/boton_bloques" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E; Toque" android:textColor="@color/blanco" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_weight="1" android:layout_marginTop="8dp"><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1.2" android:background="@drawable/ficha_rosa" android:padding="10dp" ><TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_rosa_texto" android:textSize="10sp" />
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_rosa_texto" android:textSize="42sp" android:letterSpacing="-0.03"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:background="@drawable/ficha_lila" android:padding="10dp" android:layout_marginHorizontal="8dp"><TextView android:id="@+id/horas_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="horas" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_lila_texto" android:textSize="10sp" />
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_lila_texto" android:textSize="42sp" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1.3" android:background="@drawable/ficha_menta" android:padding="10dp" ><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="min · seg" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_menta_texto" android:textSize="10sp" />
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_menta_texto" android:textSize="26sp" /></LinearLayout></LinearLayout></LinearLayout>
