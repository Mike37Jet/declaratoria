<?xml version="1.0" encoding="utf-8"?>
<!-- La pantalla principal como taquilla de cine: marquesina, boleto, toque, tira de película y cartelera. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema"
    android:fillViewport="true"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/ayuda"
            style="@style/AccionTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/ayuda" />

        <com.roguelito.rommicines.Marquesina
            android:id="@+id/marquesina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.roguelito.rommicines.Boleto
            android:id="@+id/boleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <!-- El toque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_taquilla"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/destinatario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/un_toque"
                android:textColor="@color/cream"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/ultimo_recibido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cream_soft"
                android:textSize="13sp"
                android:visibility="gone" />
            <!-- La frase que se manda: un campo que abre la lista (antes eran pastillas). -->
            <TextView
                android:id="@+id/frase_toque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/campo_frase"
                android:drawableEnd="@drawable/ic_desplegar"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cream"
                android:textSize="16sp" />
            <Button
                android:id="@+id/mandar_toque"
                style="@style/AccionPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/enviar_taquilla"
                android:text="@string/enviar_toque" />
            <TextView
                android:id="@+id/estado_toque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/cream_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Solo salen si falta algo para que los toques lleguen. -->
        <Button
            android:id="@+id/aviso_recepcion"
            style="@style/AccionTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <Button
            android:id="@+id/aviso_segundo_plano"
            style="@style/AccionTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- En pantalla: los recuerdos como tira de película -->
        <LinearLayout
            android:id="@+id/cabecera_fotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/titulo_fotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/en_pantalla"
                android:textColor="@color/cream"
                android:textSize="19sp" />
            <Button
                android:id="@+id/abrir_tablero"
                style="@style/AccionTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/abrir_tablero" />
            <Button
                android:id="@+id/ver_funcion"
                style="@style/AccionTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="0dp"
                android:text="@string/ver_la_funcion" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cinta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#000000"
            android:orientation="vertical">
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/perforacion" />
            <HorizontalScrollView
                android:id="@+id/tira_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/tira"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            </HorizontalScrollView>
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/perforacion" />
        </LinearLayout>
        <TextView
            android:id="@+id/pie_tira"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/cream_soft"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/resultado_fotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/estado_fotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/cream_soft"
                android:textSize="13sp" />
            <Button
                android:id="@+id/accion_fotos"
                style="@style/AccionTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/deshacer" />
        </LinearLayout>

        <!-- Cartelera: los próximos planes de la libreta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/cartelera"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.15"
                    android:text="@string/cartelera"
                    android:textColor="@color/gold"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/cuenta_libreta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/cream_soft"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/planes_cartelera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/taquilla_borde_suave" />
            <Button
                android:id="@+id/abrir_libreta"
                style="@style/AccionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/abrir_libreta" />
        </LinearLayout>

        <Button
            android:id="@+id/poner_widget"
            style="@style/AccionSecundaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/anadir_widget" />
    </LinearLayout>
</ScrollView>
