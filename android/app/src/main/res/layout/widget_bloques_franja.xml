<?xml version="1.0" encoding="utf-8"?>
<!-- Contador en franja (3×1, 4×1), diseño Bloques. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_bloques" android:orientation="horizontal" android:padding="8dp" ><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:background="@drawable/ficha_rosa" android:gravity="center"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_rosa_texto" android:textSize="21sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_rosa_texto" android:textSize="10sp" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:background="@drawable/ficha_lila" android:gravity="center" android:layout_marginHorizontal="5dp"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_lila_texto" android:textSize="21sp" />
<TextView android:id="@+id/horas_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="horas" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_lila_texto" android:textSize="10sp" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1.3" android:background="@drawable/ficha_menta" android:gravity="center"><Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_menta_texto" android:textSize="16sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="min · seg" android:fontFamily="sans-serif-black" android:textColor="@color/bloques_menta_texto" android:textSize="10sp" /></LinearLayout>
<TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/boton_bloques" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/blanco" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:minWidth="42dp" android:layout_marginStart="5dp"/></LinearLayout>
