<?xml version="1.0" encoding="utf-8"?>
<!-- Widget contador: el mismo "tiempo desde que dijiste que sí" de la página. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/marco"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="@string/contador_titulo"
        android:textColor="@color/gold"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="16"
                android:textColor="@color/gold_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dias_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="DÍAS"
                android:textColor="@color/cream_soft"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/horas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="05"
                android:textColor="@color/gold_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/horas_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="HORAS"
                android:textColor="@color/cream_soft"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1.6"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <Chronometer
                android:id="@+id/minseg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                
                android:textColor="@color/gold_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minseg_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="MIN · SEG"
                android:textColor="@color/cream_soft"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Abajo: el último toque (o el pie de siempre) y el botón para mandar uno. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/pie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/contador_pie"
            android:textColor="@color/cream_soft"
            android:textSize="11sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/enviar_toque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/boton_toque"
            android:contentDescription="Mandar un toque"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:text="♥&#xFE0E;"
            android:textColor="@color/gold_light"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
