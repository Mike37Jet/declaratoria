<?xml version="1.0" encoding="utf-8"?>
<!-- Widget carrusel: una tira de película con las fotos pasando solas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/marco"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:background="@drawable/perforacion" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cinema">

        <AdapterViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="6000"
            android:inAnimation="@android:animator/fade_in"
            android:outAnimation="@android:animator/fade_out"
            android:loopViews="true" />

        <TextView
            android:id="@+id/vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/carrusel_vacio"
            android:textColor="@color/gold_light"
            android:textSize="15sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/ir_pagina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/pastilla"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/ver_funcion"
            android:textColor="@color/gold_light"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:background="@drawable/perforacion" />
</LinearLayout>
