<?xml version="1.0" encoding="utf-8"?>
<!-- Contador compacto (2×1, 1×1), diseño Anillo. Tocarlo manda un toque; el ♥ abre la página. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_grafito" android:orientation="horizontal" android:padding="13dp" android:gravity="center" android:contentDescription="Mandar un toque"><FrameLayout android:layout_width="42dp" android:layout_height="42dp">
<ImageView android:id="@+id/grafico" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
<TextView android:id="@+id/abrir_pagina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Abrir la página de ROMMICINES" android:includeFontPadding="false" android:text="♥&#xFE0E;" android:textColor="@color/anillo_rosa" android:textSize="13sp" android:layout_gravity="center"/>
</FrameLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="21sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="21sp" android:layout_marginStart="4dp"/></LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="10sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" h · " android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="10sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="10sp" /></LinearLayout></LinearLayout></LinearLayout>
