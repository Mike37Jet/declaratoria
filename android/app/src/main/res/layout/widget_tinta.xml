<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Tinta: un solo color y letra delgada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_tinta" android:orientation="vertical" android:padding="21dp" ><TextView android:id="@+id/pie" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="desde el sí · ♥" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="13sp" android:letterSpacing="0.03"/>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_texto" android:textSize="42sp" android:letterSpacing="-0.03"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="d" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="16sp" android:layout_marginStart="2dp" android:layout_marginEnd="14dp"/>
<TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_texto" android:textSize="42sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="h" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="16sp" android:layout_marginStart="2dp"/>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_acento" android:textSize="21sp" /></LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<ImageView android:layout_width="match_parent" android:layout_height="1dp" android:importantForAccessibility="no" android:background="@color/tinta_borde" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"><TextView android:id="@+id/meta" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/tinta_acento" android:textSize="13sp" android:layout_weight="1"/>
<TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/boton_tinta" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E; toque" android:textColor="@color/tinta_acento" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:paddingHorizontal="12dp" android:paddingVertical="3dp"/></LinearLayout></LinearLayout>
