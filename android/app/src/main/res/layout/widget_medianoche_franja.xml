<?xml version="1.0" encoding="utf-8"?>
<!-- Contador en franja (3×1, 4×1), diseño Medianoche. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/marco_medianoche" android:gravity="center_vertical" android:orientation="horizontal"
    android:padding="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:includeFontPadding="false" android:text="37" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_texto" android:textSize="19sp" />
            <TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="días" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_gris" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:includeFontPadding="false" android:text="05" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_texto" android:textSize="19sp" />
            <TextView android:id="@+id/horas_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="horas" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_gris" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp"
            android:layout_weight="1.6" android:gravity="center" android:orientation="vertical">
            <Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:includeFontPadding="false" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_texto" android:textSize="19sp" />
            <TextView android:id="@+id/minseg_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="min · seg" android:fontFamily="sans-serif-thin" android:textColor="@color/medianoche_gris" android:textSize="9sp" />
        </LinearLayout>
    <TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:background="@drawable/boton_medianoche" android:contentDescription="Mandar un toque" android:gravity="center"
            android:minWidth="40dp" android:paddingHorizontal="12dp" android:paddingVertical="3dp" android:layout_marginStart="3dp"
            android:text="♡" android:textColor="@color/medianoche_texto" android:textSize="15sp" />
</LinearLayout>
