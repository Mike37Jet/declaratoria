<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Coral (One UI): color fuerte y letras blancas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_coral" android:orientation="horizontal" android:padding="21dp" ><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1"><TextView android:id="@+id/pie" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Juntos desde el sí" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="13sp" />
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="55sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="16sp" android:layout_marginStart="6dp"/></LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/coral_crema" android:textSize="13sp" /></LinearLayout>
<LinearLayout android:layout_width="96dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_marginStart="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:background="@drawable/caja_coral" android:gravity="center"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" h" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" /></LinearLayout>
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="13sp" /></LinearLayout>
<TextView android:id="@+id/enviar_toque" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/boton_coral" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E; Toque" android:textColor="@color/coral_fondo" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:layout_marginTop="6dp" android:textStyle="bold"/></LinearLayout></LinearLayout>
