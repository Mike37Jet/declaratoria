<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Puntos: un punto por cada día del mes juntos; el de hoy va en blanco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_grafito" android:orientation="vertical" android:padding="21dp" ><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="34sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif" android:textColor="@color/puntos_gris" android:textSize="13sp" android:layout_marginStart="6dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" juntos" android:fontFamily="sans-serif" android:textColor="@color/puntos_gris" android:textSize="13sp" />
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-medium" android:textColor="@color/puntos_rosa" android:textSize="13sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=":" android:fontFamily="sans-serif-medium" android:textColor="@color/puntos_rosa" android:textSize="13sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/puntos_rosa" android:textSize="13sp" /></LinearLayout>
<ImageView android:id="@+id/grafico" android:layout_width="match_parent" android:layout_height="0dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:layout_weight="1" android:layout_marginVertical="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/pie" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="" android:fontFamily="sans-serif" android:textColor="@color/puntos_gris" android:textSize="10sp" android:layout_weight="1" android:visibility="gone"/>
<TextView android:id="@+id/meta" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/puntos_gris" android:textSize="10sp" android:layout_weight="1"/>
<TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/boton_grafito_lleno" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/puntos_rosa" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:paddingHorizontal="12dp" android:paddingVertical="2dp"/></LinearLayout></LinearLayout>
