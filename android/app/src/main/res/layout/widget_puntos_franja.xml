<?xml version="1.0" encoding="utf-8"?>
<!-- Contador en franja (3×1, 4×1), diseño Puntos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_grafito" android:orientation="horizontal" android:padding="13dp" android:gravity="center_vertical"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" ><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="26sp" android:letterSpacing="-0.03"/>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif" android:textColor="@color/puntos_rosa" android:textSize="10sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=":" android:fontFamily="sans-serif" android:textColor="@color/puntos_rosa" android:textSize="10sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/puntos_rosa" android:textSize="10sp" /></LinearLayout></LinearLayout>
<ImageView android:id="@+id/grafico" android:layout_width="0dp" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" android:layout_weight="1" android:layout_marginHorizontal="10dp"/>
<TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/boton_grafito_lleno" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/puntos_rosa" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:minWidth="42dp"/></LinearLayout>
