<?xml version="1.0" encoding="utf-8"?>
<!-- Contador en franja (3×1, 4×1), diseño Barra Now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_barra" android:orientation="horizontal" android:padding="13dp" android:gravity="center_vertical"><TextView android:id="@+id/enviar_toque" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/boton_barra" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/blanco" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" android:layout_marginStart="4dp"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="13sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=":" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="13sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="13sp" /></LinearLayout>
<ProgressBar android:id="@+id/barra" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="1000" android:progress="630" android:progressDrawable="@drawable/barra_progreso" android:layout_marginTop="5dp"/>
<TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/barra_gris" android:textSize="10sp" android:layout_marginTop="3dp"/></LinearLayout></LinearLayout>
