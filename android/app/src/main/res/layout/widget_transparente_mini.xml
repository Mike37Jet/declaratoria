<?xml version="1.0" encoding="utf-8"?>
<!-- Contador compacto (2×1, 1×1), diseño Transparente. Tocarlo manda un toque; el ♥ abre la página. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="13dp" android:gravity="center_vertical" android:contentDescription="Mandar un toque"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/abrir_pagina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Abrir la página de ROMMICINES" android:includeFontPadding="false" android:text="♥&#xFE0E;" android:textColor="@color/blanco" android:textSize="10sp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" " android:fontFamily="sans-serif" android:textColor="@color/blanco" android:textSize="10sp" />
<TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif" android:textColor="@color/blanco" android:textSize="10sp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif" android:textColor="@color/blanco" android:textSize="10sp" android:layout_marginStart="3dp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/></LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=":" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/>
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-black" android:textColor="@color/blanco" android:textSize="21sp" android:shadowColor="@color/transparente_sombra" android:shadowRadius="6" android:shadowDy="1"/></LinearLayout></LinearLayout>
