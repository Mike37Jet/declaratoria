<?xml version="1.0" encoding="utf-8"?>
<!-- Contador compacto (2×1, 1×1), diseño Tinta. Tocarlo manda un toque; el ♥ abre la página. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_tinta" android:orientation="vertical" android:padding="13dp" android:gravity="center_vertical" android:contentDescription="Mandar un toque"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/abrir_pagina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Abrir la página de ROMMICINES" android:includeFontPadding="false" android:text="♥&#xFE0E;" android:textColor="@color/tinta_acento" android:textSize="10sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" desde el sí" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="10sp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_texto" android:textSize="21sp" android:letterSpacing="-0.03"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="d" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="10sp" android:layout_marginEnd="6dp"/>
<TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_texto" android:textSize="21sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="h" android:fontFamily="sans-serif" android:textColor="@color/tinta_acento" android:textSize="10sp" />
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-light" android:textColor="@color/tinta_acento" android:textSize="13sp" /></LinearLayout></LinearLayout>
