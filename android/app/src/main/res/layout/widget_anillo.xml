<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Anillo: el anillo avanza hacia el próximo mes juntos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/marco_grafito" android:orientation="horizontal" android:padding="21dp" android:gravity="center"><FrameLayout android:layout_width="96dp" android:layout_height="96dp">
<ImageView android:id="@+id/grafico" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
<TextView android:id="@+id/enviar_toque" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/boton_grafito" android:contentDescription="Mandar un toque" android:gravity="center" android:maxLines="1" android:text="♥&#xFE0E;" android:textColor="@color/anillo_rosa" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:layout_gravity="center"/>
</FrameLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp"><TextView android:id="@+id/pie" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Juntos" android:fontFamily="sans-serif-medium" android:textColor="@color/anillo_rosa" android:textSize="13sp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp"><TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="38" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="34sp" android:letterSpacing="-0.03"/>
<TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="días" android:fontFamily="sans-serif-medium" android:textColor="@color/blanco" android:textSize="34sp" android:layout_marginStart="6dp"/></LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp"><TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text="04" android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="13sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:text=" h · " android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="13sp" />
<Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/anillo_gris" android:textSize="13sp" /></LinearLayout>
<TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="faltan 22 días para 2 meses" android:textColor="@color/anillo_rosa" android:textSize="13sp" android:layout_marginTop="3dp"/></LinearLayout></LinearLayout>
