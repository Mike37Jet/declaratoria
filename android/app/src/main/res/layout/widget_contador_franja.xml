<?xml version="1.0" encoding="utf-8"?>
<!-- Contador en franja: para cuando el widget es ancho pero bajito (3×1, 4×1).
     Las mismas tres cajitas del grande, en una sola fila y más chicas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/marco"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="16"
                android:textColor="@color/gold_light"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dias_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="DÍAS"
                android:textColor="@color/cream_soft"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/horas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="05"
                android:textColor="@color/gold_light"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/horas_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="HORAS"
                android:textColor="@color/cream_soft"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1.6"
            android:background="@drawable/caja"
            android:gravity="center"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/minseg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/gold_light"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minseg_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="MIN · SEG"
                android:textColor="@color/cream_soft"
                android:textSize="8sp" />
        </LinearLayout>

    <TextView
        android:id="@+id/enviar_toque"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:background="@drawable/boton_toque"
        android:contentDescription="Mandar un toque"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="♥&#xFE0E;"
        android:textColor="@color/gold_light"
        android:textSize="15sp" />
</LinearLayout>
