<?xml version="1.0" encoding="utf-8"?>
<!-- Contador completo, diseño Perla: centrado, con letra serif y doble filete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/marco_perla" android:gravity="center" android:orientation="vertical"
    android:padding="21dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif"
        android:letterSpacing="0.3" android:text="@string/perla_titulo" android:textColor="@color/perla_acento"
        android:textSize="10sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginVertical="2dp"
        android:baselineAligned="true" android:orientation="horizontal">
        <TextView android:id="@+id/dias" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:maxLines="1" android:text="37" android:textColor="@color/perla_texto"
            android:textSize="26sp" />
        <TextView android:id="@+id/dias_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:fontFamily="serif" android:text="días"
            android:textColor="@color/perla_texto" android:textSize="13sp" android:textStyle="italic" />
        <TextView android:id="@+id/horas" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:fontFamily="serif" android:maxLines="1" android:text="5"
            android:textColor="@color/perla_texto" android:textSize="26sp" />
        <TextView android:id="@+id/horas_etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:fontFamily="serif" android:text="horas"
            android:textColor="@color/perla_texto" android:textSize="13sp" android:textStyle="italic" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <Chronometer android:id="@+id/minseg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textColor="@color/perla_acento" android:textSize="13sp"
            android:textStyle="italic" />
        <TextView android:id="@+id/enviar_toque" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="2dp" android:background="@drawable/boton_perla"
            android:contentDescription="Mandar un toque" android:gravity="center" android:minWidth="40dp"
            android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:text="♥&#xFE0E;"
            android:textColor="@color/perla_acento" android:textSize="16sp" />
    </LinearLayout>
    <!-- Solo aparece cuando hay un toque reciente. -->
    <TextView android:id="@+id/pie" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:textColor="@color/perla_acento"
        android:textSize="10sp" android:textStyle="italic" android:visibility="gone" />
</LinearLayout>
