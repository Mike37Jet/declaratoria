<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Al reiniciar el celular el contador tiene que volver a sincronizarse. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Toques: mandarlos por internet y avisar cuando llegan. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para pedir que Android no frene los envíos en segundo plano (la app no va a Play Store). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para que la hora del contador cambie en el segundo exacto. Sin esto
         Android puede retrasar el cambio hasta 10 minutos. En Android 13+
         USE_EXACT_ALARM se concede solo al instalar (la app no va a Play Store,
         así que su política no aplica); en 12 hay que pedirlo al usuario. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Elegir el diseño del contador: la abre el launcher al poner o editar el widget. -->
        <activity
            android:name=".libreta.LibretaActivity"
            android:exported="false"
            android:label="@string/nuestra_libreta"
            android:theme="@style/TemaLibreta"
            android:windowSoftInputMode="adjustResize" />
        <!-- Recibe los toques del widget de la libreta: firma encima de la pantalla de inicio o abre la libreta. -->
        <activity
            android:name=".libreta.AccionLibretaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/TemaNotaWidget" />
        <activity
            android:name=".tablero.TableroActivity"
            android:exported="false"
            android:label="@string/carrusel_nombre"
            android:theme="@style/TemaTablero"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".libreta.AlbumActivity"
            android:exported="false"
            android:label="Nuestro álbum"
            android:theme="@style/TemaLibreta" />
        <activity
            android:name=".ElegirTemaActivity"
            android:exported="true"
            android:label="@string/elegir_diseno">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".libreta.LibretaWidget"
            android:exported="false"
            android:label="@string/libreta_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/libreta_info" />
        </receiver>

        <!-- Los renglones (planes pendientes) del widget de la libreta. -->
        <service
            android:name=".libreta.LibretaWidgetServicio"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".CarruselWidget"
            android:exported="false"
            android:label="@string/carrusel_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carrusel_info" />
        </receiver>

        <receiver android:name=".ToqueReceiver" android:exported="false" />

        <service
            android:name=".ToquesService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <receiver
            android:name=".ContadorWidget"
            android:exported="false"
            android:label="@string/contador_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contador_info" />
        </receiver>


        <!-- WorkManager lo activa y desactiva en cada envío (solo sirve para alarmas en
             Android < 6). Cada cambio hace que el launcher redibuje todos los widgets
             y se ve un parpadeo. -->
        <receiver
            android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver"
            tools:node="remove" />
    </application>
</manifest>
