rules_version = '2';

// Reglas de la libreta compartida (Firestore). Se pegan en la consola de Firebase:
// Firestore Database → Reglas → Publicar.
//
// - parejas/{p}: los dos miembros y sus nombres/tintas. Solo los miembros la leen.
//   Para unirse hace falta el id, que solo se conoce con el código (codigos/{codigo}).
// - parejas/{p}/... (planes, y más adelante recuerdos y fotos): solo los miembros.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function miembro(p) {
      return conSesion()
        && request.auth.uid in get(/databases/$(database)/documents/parejas/$(p)).data.miembros;
    }

    // Código de 6 letras que el primero le pasa al segundo. Se lee de uno en uno
    // (no se pueden listar) y lo borra quien lo creó o un miembro al usarlo.
    match /codigos/{codigo} {
      allow get: if conSesion();
      allow create: if conSesion() && request.resource.data.creador == request.auth.uid;
      allow delete: if conSesion()
        && (resource.data.creador == request.auth.uid || miembro(resource.data.pareja));
    }

    match /parejas/{p} {
      allow read: if conSesion() && request.auth.uid in resource.data.miembros;
      allow create: if conSesion() && request.resource.data.miembros == [request.auth.uid];
      allow update: if conSesion() && (
        request.auth.uid in resource.data.miembros
        // Unirse: solo se agrega uno mismo, cuando todavía hay un solo miembro.
        || (resource.data.miembros.size() == 1
            && request.resource.data.miembros == resource.data.miembros.concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'nombres', 'tintas']))
      );

      match /{todo=**} {
        allow read, write: if miembro(p);
      }
    }
  }
}
